+    "Tech Vibe": HC3Scene(31, 80, 100, 1, 0, 1, ((0, 100, 100, 0, 0), (300, 100, 100, 0, 0), (240, 100, 100, 0, 0), (180, 100, 100, 0, 0), (120, 100, 100, 0, 0), (60, 100, 100, 0, 0))),
